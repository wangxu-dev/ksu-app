{
  "name": "ksu-app",
  "version": "0.0.2",
  "private": true,
  "description": "Ksu-App desktop client with campus data and built-in assistant.",
  "author": "wangxu-dev",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "tsr generate && vite",
    "electron:dev": "concurrently -k \"npm run electron:watch:main\" \"npm run dev\" \"wait-on tcp:1420 file:dist-electron/main.js && electron .\"",
    "build": "tsr generate && tsc && vite build && npm run electron:build:main",
    "electron:build:main": "tsc -p tsconfig.electron.json",
    "electron:watch:main": "tsc -p tsconfig.electron.json --watch --preserveWatchOutput",
    "electron:build": "npm run build && npm run electron:build:main",
    "pack:dir": "npm run electron:build && electron-builder --config electron-builder.yml --dir --publish never",
    "pack:local": "npm run electron:build && electron-builder --config electron-builder.yml --publish never",
    "icons:electron": "python scripts/generate_electron_icons.py",
    "preview": "vite preview",
    "typecheck": "tsr generate && tsc -noEmit && tsc -p tsconfig.electron.json --noEmit",
    "lint": "oxlint src electron --deny-warnings",
    "lint:fix": "oxlint src electron --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "tsr": "tsr generate",
    "tsr:watch": "tsr watch"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openrouter/agent": "^0.4.0",
    "@openrouter/sdk": "^0.12.20",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.100.1",
    "@tanstack/react-router": "^1.168.23",
    "@uiw/react-markdown-preview": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron-updater": "^6.8.3",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.9.0",
    "next-themes": "^0.4.6",
    "openai": "^6.34.0",
    "react": "^19.2.5",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/router-cli": "^1.166.34",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "oxfmt": "latest",
    "oxlint": "^1.61.0",
    "tailwindcss": "^4.2.4",
    "typescript": "~6.0.3",
    "vite": "^8.0.10",
    "wait-on": "^9.0.5"
  }
}
