{
  "name": "ksu-app",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "tsr generate && vite",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on tcp:1420 && electron .\"",
    "build": "tsr generate && tsc && vite build",
    "electron:build": "npm run build",
    "icons:electron": "python scripts/generate_electron_icons.py",
    "preview": "vite preview",
    "typecheck": "tsr generate && tsc -noEmit",
    "lint": "oxlint src electron --deny-warnings",
    "lint:fix": "oxlint src electron --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "tsr": "tsr generate",
    "tsr:watch": "tsr watch"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.34",
    "@ai-sdk/react": "^3.0.103",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-router": "^1.163.2",
    "ai": "^6.0.101",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron-updater": "^6.8.3",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^0.575.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-day-picker": "^9.13.2",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/router-cli": "^1.163.2",
    "@types/node": "^25.3.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "concurrently": "^9.2.1",
    "electron": "^40.6.1",
    "oxfmt": "latest",
    "oxlint": "^1.50.0",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "wait-on": "^9.0.4"
  }
}
